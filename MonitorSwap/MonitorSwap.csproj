<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>MonitorSwap</AssemblyName>
    <RootNamespace>MonitorSwap</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- .NET kurulu olmayan bilgisayarlarda da çalışsın diye her şey tek exe'nin içinde -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Monitor Swap</Product>
    <AssemblyTitle>Monitor Swap</AssemblyTitle>
    <Description>Monitör girişini bilgisayar ile konsol arasında tek tuşla değiştirir.</Description>
    <Version>1.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Exe'ye derleyen bilgisayarın klasör yolları (kullanıcı adı dahil) gömülmesin -->
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kodla üretilmiş özgün efekt sesleri -->
    <EmbeddedResource Include="Sounds\*.wav" LogicalName="MonitorSwap.Sounds.%(Filename)%(Extension)" />
    <!-- Macera teması başlık fontu (SIL Open Font License, bkz. Fonts\OFL.txt). Dosya yoksa Segoe UI kullanılır. -->
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="MonitorSwap.Fonts.%(Filename)%(Extension)" Condition="Exists('Fonts')" />
  </ItemGroup>

</Project>
